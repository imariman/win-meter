<Window x:Class="WinMeter.Ui.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WinMeter.Ui"
        Title="WinMeter"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#14161C"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A7AEC0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F6FB"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Detail" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B93A7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C5CAD6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Padding="16,14,16,12" Background="#14161C">
        <StackPanel>
            <Grid Margin="2,0,0,12">
                <StackPanel>
                    <TextBlock Text="WinMeter" FontSize="16" FontWeight="SemiBold" Foreground="#F4F6FB"/>
                    <TextBlock Text="Last 60 seconds" FontSize="12" Foreground="#8B93A7" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="&#x2715;" Style="{StaticResource CloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseButton_Click"/>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="CPU" Style="{StaticResource Title}"/>
                        <TextBlock Text="{Binding CpuValue}" Style="{StaticResource Value}"/>
                    </Grid>
                    <ui:SparklineControl Height="42" Margin="0,8,0,0" Stroke="#7EB6FF" RangeMax="100" Values="{Binding CpuSeries}"/>
                    <TextBlock Text="{Binding CpuDetail}" Style="{StaticResource Detail}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Memory" Style="{StaticResource Title}"/>
                        <TextBlock Text="{Binding RamValue}" Style="{StaticResource Value}"/>
                    </Grid>
                    <ui:SparklineControl Height="42" Margin="0,8,0,0" Stroke="#3DDC97" RangeMax="100" Values="{Binding RamSeries}"/>
                    <TextBlock Text="{Binding RamDetail}" Style="{StaticResource Detail}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Disk" Style="{StaticResource Title}"/>
                        <TextBlock Text="{Binding DiskValue}" Style="{StaticResource Value}"/>
                    </Grid>
                    <ui:SparklineControl Height="42" Margin="0,8,0,0" Stroke="#F5A524" Values="{Binding DiskSeries}"/>
                    <TextBlock Text="{Binding DiskDetail}" Style="{StaticResource Detail}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Network · download" Style="{StaticResource Title}"/>
                        <TextBlock Text="{Binding NetValue}" Style="{StaticResource Value}"/>
                    </Grid>
                    <ui:SparklineControl Height="42" Margin="0,8,0,0" Stroke="#C084FC" Values="{Binding NetSeries}"/>
                    <TextBlock Text="{Binding NetDetail}" Style="{StaticResource Detail}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
