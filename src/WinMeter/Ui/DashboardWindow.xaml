<Window x:Class="WinMeter.Ui.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WinMeter.Ui"
        Title="WinMeter"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Palette. Metric accents follow the logo; keep them in sync with DashboardViewModel and TaskbarStrip. -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="CardBrush" Color="#172136"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#243149"/>
        <SolidColorBrush x:Key="RaisedBrush" Color="#22304A"/>
        <SolidColorBrush x:Key="RaisedBorderBrush" Color="#3B4A63"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#26324A"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="FocusBrush" Color="#60A5FA"/>
        <SolidColorBrush x:Key="SwitchOnBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
        <SolidColorBrush x:Key="CriticalBrush" Color="#F87171"/>
        <SolidColorBrush x:Key="CpuBrush" Color="#60A5FA"/>
        <SolidColorBrush x:Key="MemoryBrush" Color="#4ADE80"/>
        <SolidColorBrush x:Key="GpuBrush" Color="#F472B6"/>
        <SolidColorBrush x:Key="DiskBrush" Color="#2DD4BF"/>
        <SolidColorBrush x:Key="NetworkBrush" Color="#A78BFA"/>

        <BooleanToVisibilityConverter x:Key="Show"/>
        <ui:LevelBrushConverter x:Key="LevelBrush" High="{StaticResource WarningBrush}" Critical="{StaticResource CriticalBrush}"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12,14,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="AccentDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Detail" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="LevelPill" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,0,6,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Background" Value="{StaticResource TrackBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CoreMeter" TargetType="ProgressBar" BasedOn="{StaticResource Meter}">
            <Setter Property="Margin" Value="0,4,0,3"/>
        </Style>
        <Style x:Key="Sparkline" TargetType="ui:SparklineControl">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Taskbar toggles. Foreground is the metric accent; the dot fills in when the meter is shown. -->
        <Style x:Key="Chip" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Chip" Background="Transparent" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5,12,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="Transparent" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Margin="0,1,7,0" VerticalAlignment="Center"/>
                                <ContentPresenter x:Name="Label" VerticalAlignment="Center"
                                                  TextElement.FontSize="12" TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource RaisedBrush}"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource RaisedBorderBrush}"/>
                                <Setter TargetName="Dot" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="34" Height="20" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="10" Background="{StaticResource TrackBrush}" BorderBrush="{StaticResource RaisedBorderBrush}" BorderThickness="1"/>
                                <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource SwitchOnBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource SwitchOnBrush}"/>
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Slim scrollbar that matches the dark surface. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" Width="4" CornerRadius="2" Background="#33FFFFFF" HorizontalAlignment="Right"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="#66FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="16,14,16,12">
        <StackPanel x:Name="Root">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="RootOffset"/>
            </StackPanel.RenderTransform>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Border.Background>
                        <ImageBrush ImageSource="pack://application:,,,/Assets/winmeter-logo.jpg" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Heading}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource MemoryBrush}" VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock Text="{Binding RangeLabel}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Content="&#xE8BB;" Style="{StaticResource CloseButton}" VerticalAlignment="Top"
                        ToolTip="Close (Esc)" AutomationProperties.Name="Close" Click="CloseButton_Click"/>
            </Grid>

            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="3" Margin="0,0,0,12" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" AutomationProperties.Name="History range">
                    <Button x:Name="RangeMinuteButton" Content="1 min" Tag="60" Style="{StaticResource QuietButton}" Click="Range_Click" Margin="0,0,2,0"/>
                    <Button x:Name="RangeTenButton" Content="10 min" Tag="600" Style="{StaticResource QuietButton}" Click="Range_Click" Margin="0,0,2,0"/>
                    <Button x:Name="RangeHourButton" Content="1 hour" Tag="3600" Style="{StaticResource QuietButton}" Click="Range_Click"/>
                </StackPanel>
            </Border>

            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding ShowingAll, Converter={StaticResource Show}}">
            <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Show on taskbar" Style="{StaticResource Title}" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <CheckBox Content="CPU" Tag="Cpu" IsChecked="{Binding StripCpu, Mode=OneWay}" Foreground="{StaticResource CpuBrush}" Style="{StaticResource Chip}" Click="Strip_Click"/>
                        <CheckBox Content="RAM" Tag="Memory" IsChecked="{Binding StripMemory, Mode=OneWay}" Foreground="{StaticResource MemoryBrush}" Style="{StaticResource Chip}" Click="Strip_Click"/>
                        <CheckBox Content="GPU" Tag="Gpu" IsChecked="{Binding StripGpu, Mode=OneWay}" Foreground="{StaticResource GpuBrush}" Style="{StaticResource Chip}" Click="Strip_Click"/>
                        <CheckBox Content="SSD" Tag="Disk" IsChecked="{Binding StripDisk, Mode=OneWay}" Foreground="{StaticResource DiskBrush}" Style="{StaticResource Chip}" Click="Strip_Click"/>
                        <CheckBox Content="NET" Tag="Network" IsChecked="{Binding StripNetwork, Mode=OneWay}" Foreground="{StaticResource NetworkBrush}" Style="{StaticResource Chip}" Click="Strip_Click" Margin="0,0,0,6"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="This PC" Style="{StaticResource Title}" Margin="0,0,0,8"/>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Model" Style="{StaticResource InfoLabel}"/>
                        <TextBlock Text="{Binding PcModel}" Style="{StaticResource InfoValue}"/>
                    </Grid>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Processor" Style="{StaticResource InfoLabel}"/>
                        <TextBlock Text="{Binding PcProcessor}" Style="{StaticResource InfoValue}"/>
                    </Grid>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Memory" Style="{StaticResource InfoLabel}"/>
                        <TextBlock Text="{Binding PcMemory}" Style="{StaticResource InfoValue}"/>
                    </Grid>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Graphics" Style="{StaticResource InfoLabel}"/>
                        <TextBlock Text="{Binding PcGraphics}" Style="{StaticResource InfoValue}"/>
                    </Grid>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="System" Style="{StaticResource InfoLabel}"/>
                        <TextBlock Text="{Binding PcWindows}" Style="{StaticResource InfoValue}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" AutomationProperties.Name="{Binding CpuValue, StringFormat=CPU {0}}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource AccentDot}" Fill="{StaticResource CpuBrush}"/>
                            <TextBlock Text="CPU" Style="{StaticResource Title}"/>
                            <Border Style="{StaticResource LevelPill}" Tag="{Binding CpuLevel}" BorderBrush="{Binding CpuLevel, Converter={StaticResource LevelBrush}}">
                                <TextBlock Text="{Binding CpuLevel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding CpuLevel, Converter={StaticResource LevelBrush}}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding CpuValue}" Style="{StaticResource Value}"
                                   Foreground="{Binding CpuLevel, Converter={StaticResource LevelBrush}, ConverterParameter={StaticResource TextPrimaryBrush}}"/>
                    </Grid>
                    <ProgressBar Style="{StaticResource Meter}" Value="{Binding CpuPercent, Mode=OneWay}"
                                 Foreground="{Binding CpuLevel, Converter={StaticResource LevelBrush}, ConverterParameter={StaticResource CpuBrush}}"/>
                    <ui:SparklineControl Style="{StaticResource Sparkline}" Stroke="{StaticResource CpuBrush}" RangeMax="100" Values="{Binding CpuSeries}"/>
                    <TextBlock Text="{Binding CpuDetail}" Style="{StaticResource Detail}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" AutomationProperties.Name="{Binding RamValue, StringFormat=Memory {0}}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource AccentDot}" Fill="{StaticResource MemoryBrush}"/>
                            <TextBlock Text="Memory" Style="{StaticResource Title}"/>
                            <Border Style="{StaticResource LevelPill}" Tag="{Binding RamLevel}" BorderBrush="{Binding RamLevel, Converter={StaticResource LevelBrush}}">
                                <TextBlock Text="{Binding RamLevel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding RamLevel, Converter={StaticResource LevelBrush}}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding RamValue}" Style="{StaticResource Value}"
                                   Foreground="{Binding RamLevel, Converter={StaticResource LevelBrush}, ConverterParameter={StaticResource TextPrimaryBrush}}"/>
                    </Grid>
                    <ProgressBar Style="{StaticResource Meter}" Value="{Binding RamPercent, Mode=OneWay}"
                                 Foreground="{Binding RamLevel, Converter={StaticResource LevelBrush}, ConverterParameter={StaticResource MemoryBrush}}"/>
                    <ui:SparklineControl Style="{StaticResource Sparkline}" Stroke="{StaticResource MemoryBrush}" RangeMax="100" Values="{Binding RamSeries}"/>
                    <TextBlock Text="{Binding RamDetail}" Style="{StaticResource Detail}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" AutomationProperties.Name="{Binding GpuValue, StringFormat=GPU {0}}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource AccentDot}" Fill="{StaticResource GpuBrush}"/>
                            <TextBlock Text="GPU" Style="{StaticResource Title}"/>
                            <Border Style="{StaticResource LevelPill}" Tag="{Binding GpuLevel}" BorderBrush="{Binding GpuLevel, Converter={StaticResource LevelBrush}}">
                                <TextBlock Text="{Binding GpuLevel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding GpuLevel, Converter={StaticResource LevelBrush}}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding GpuValue}" Style="{StaticResource Value}"
                                   Foreground="{Binding GpuLevel, Converter={StaticResource LevelBrush}, ConverterParameter={StaticResource TextPrimaryBrush}}"/>
                    </Grid>
                    <ProgressBar Style="{StaticResource Meter}" Value="{Binding GpuPercent, Mode=OneWay}"
                                 Foreground="{Binding GpuLevel, Converter={StaticResource LevelBrush}, ConverterParameter={StaticResource GpuBrush}}"/>
                    <ui:SparklineControl Style="{StaticResource Sparkline}" Stroke="{StaticResource GpuBrush}" RangeMax="100" Values="{Binding GpuSeries}"/>
                    <TextBlock Text="{Binding GpuDetail}" Style="{StaticResource Detail}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" AutomationProperties.Name="{Binding DiskValue, StringFormat=Disk {0} used}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource AccentDot}" Fill="{StaticResource DiskBrush}"/>
                            <TextBlock Text="Disk" Style="{StaticResource Title}"/>
                            <Border Style="{StaticResource LevelPill}" Tag="{Binding DiskLevel}" BorderBrush="{Binding DiskLevel, Converter={StaticResource LevelBrush}}">
                                <TextBlock Text="{Binding DiskLevel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding DiskLevel, Converter={StaticResource LevelBrush}}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding DiskValue}" Style="{StaticResource Value}"
                                   Foreground="{Binding DiskLevel, Converter={StaticResource LevelBrush}, ConverterParameter={StaticResource TextPrimaryBrush}}"/>
                    </Grid>
                    <ProgressBar Style="{StaticResource Meter}" Value="{Binding DiskPercent, Mode=OneWay}"
                                 Foreground="{Binding DiskLevel, Converter={StaticResource LevelBrush}, ConverterParameter={StaticResource DiskBrush}}"/>
                    <ui:SparklineControl Style="{StaticResource Sparkline}" Stroke="{StaticResource DiskBrush}" Values="{Binding DiskSeries}" ToolTip="Read + write throughput"/>
                    <TextBlock Text="{Binding DiskDetail}" Style="{StaticResource Detail}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0" AutomationProperties.Name="{Binding NetValue, StringFormat=Network download {0}}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource AccentDot}" Fill="{StaticResource NetworkBrush}"/>
                            <TextBlock Text="Network" Style="{StaticResource Title}"/>
                            <TextBlock Text="download" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding NetValue}" Style="{StaticResource Value}"/>
                    </Grid>
                    <ui:SparklineControl Style="{StaticResource Sparkline}" Stroke="{StaticResource NetworkBrush}" Values="{Binding NetSeries}" ToolTip="Download throughput"/>
                    <TextBlock Text="{Binding NetDetail}" Style="{StaticResource Detail}"/>
                </StackPanel>
            </Border>
            </StackPanel>
            </ScrollViewer>
            <Grid Margin="2,12,0,0" Visibility="{Binding ShowingAll, Converter={StaticResource Show}}">
                <CheckBox x:Name="StartupBox" Content="Start with Windows" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Startup_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="Exit" Style="{StaticResource QuietButton}" Click="Exit_Click"/>
                </StackPanel>
            </Grid>

            <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding ShowingOne, Converter={StaticResource Show}}">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FocusValue}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="32" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"
                                       Foreground="{Binding FocusLevel, Converter={StaticResource LevelBrush}, ConverterParameter={StaticResource TextPrimaryBrush}}"/>
                            <Border Style="{StaticResource LevelPill}" Tag="{Binding FocusLevel}" Margin="10,4,0,0" BorderBrush="{Binding FocusLevel, Converter={StaticResource LevelBrush}}">
                                <TextBlock Text="{Binding FocusLevel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding FocusLevel, Converter={StaticResource LevelBrush}}"/>
                            </Border>
                        </StackPanel>
                        <ui:SparklineControl Height="88" Margin="0,12,0,0" Stroke="{Binding FocusStroke}" RangeMax="{Binding FocusRangeMax}" Values="{Binding FocusSeries}"/>
                        <TextBlock Text="{Binding ChartCaption}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" Visibility="{Binding ShowingCaption, Converter={StaticResource Show}}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,4,14,4">
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource InfoLabel}" Margin="0,0,16,0"/>
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource InfoValue}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0" Visibility="{Binding ShowingCores, Converter={StaticResource Show}}">
                    <StackPanel>
                        <TextBlock Text="Cores" Style="{StaticResource Title}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Cores}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="46" Margin="0,0,6,8">
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Style="{StaticResource CoreMeter}"
                                                     Foreground="{Binding Level, Converter={StaticResource LevelBrush}, ConverterParameter={StaticResource CpuBrush}}"/>
                                        <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
